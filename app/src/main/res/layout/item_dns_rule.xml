<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_option_card_inactive"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvRuleAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_rounded"
        android:letterSpacing="0.04"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="BLOKIR"
        android:textColor="#EF4444"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRuleDomain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ads.example.com"
            android:textColor="#F4F4F7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRuleNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Aturan filter kustom aktif"
            android:textColor="#85889A"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnDeleteRule"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_badge_rounded"
        android:contentDescription="Hapus"
        android:padding="9dp"
        android:src="@drawable/ic_trash"
        app:tint="#EF4444" />
</LinearLayout>
