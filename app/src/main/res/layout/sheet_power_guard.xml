<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Battery &amp; Thermal Guard"
        android:textColor="#F4F4F7"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Optimasi pemakaian radio seluler untuk mencegah HP panas"
        android:textColor="#85889A"
        android:textSize="12sp" />

    <!-- Thermal Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge_rounded"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Suhu Perangkat:"
            android:textColor="#85889A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvThermalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal (36°C)"
            android:textColor="#00D26A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/rgPowerProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rbBalanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seimbang (25s Keepalive / Adaptif)"
            android:textColor="#F4F4F7"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbSaver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Super Hemat Daya (Hemat s/d 40% Baterai)"
            android:textColor="#F4F4F7"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbPerformance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Performa Maksimal (Untuk Game Online)"
            android:textColor="#F4F4F7"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/btnApplyPowerProfile"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_dark"
        android:gravity="center"
        android:text="Terapkan Profil Daya"
        android:textColor="#F4F4F7"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
