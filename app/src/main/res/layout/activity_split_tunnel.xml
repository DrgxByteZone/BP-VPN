<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A10"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_rounded"
            android:contentDescription="Kembali"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#F4F4F7" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Split Tunneling"
                android:textColor="#F4F4F7"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Perutean Pintar &amp; Bypass Aplikasi"
                android:textColor="#85889A"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAutoBanking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_rounded"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="Bypass Bank"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Policy Selector Card -->
    <com.axel.mba.bpvpn.ui.view.LiquidGlassCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="MODE RUTE APLIKASI"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/rbAllApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/sel_radio_option_card"
                    android:button="@null"
                    android:drawableEnd="@drawable/sel_radio_check_indicator"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="Semua aplikasi lewat VPN\nSeluruh trafik jaringan dialihkan melalui tunnel"
                    android:textColor="@color/sel_radio_text_color"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbBypassSelected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/sel_radio_option_card"
                    android:button="@null"
                    android:drawableEnd="@drawable/sel_radio_check_indicator"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="Bypass aplikasi yang dipilih\nAplikasi terpilih terhubung langsung tanpa VPN"
                    android:textColor="@color/sel_radio_text_color"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbOnlySelected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sel_radio_option_card"
                    android:button="@null"
                    android:drawableEnd="@drawable/sel_radio_check_indicator"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="Hanya aplikasi yang dipilih lewat VPN\nAplikasi lain terhubung langsung di luar tunnel"
                    android:textColor="@color/sel_radio_text_color"
                    android:textSize="13sp" />
            </RadioGroup>
        </LinearLayout>
    </com.axel.mba.bpvpn.ui.view.LiquidGlassCardView>

    <!-- Sleek Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="#686B80" />

        <EditText
            android:id="@+id/etSearchApp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Cari aplikasi atau package..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="#F4F4F7"
            android:textColorHint="#4E5164"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Loading Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#10B981"
        android:visibility="gone" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSplitApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp" />

    <!-- Permanent Attribution -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/credits_brand"
        android:textColor="#4E5164"
        android:textSize="11sp" />

</LinearLayout>
