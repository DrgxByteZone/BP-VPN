<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A10"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_rounded"
            android:contentDescription="Kembali"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#F4F4F7" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kill Switch &amp; Watchdog"
                android:textColor="#F4F4F7"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Proteksi Pemutus Jaringan &amp; Auto-Reconnect"
                android:textColor="#85889A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Kill Switch Policy Card -->
            <com.axel.mba.bpvpn.ui.view.LiquidGlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KEBIJAKAN KILL SWITCH"
                        android:textColor="#686B80"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgKillSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <RadioButton
                            android:id="@+id/rbKsDisabled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/sel_radio_option_card"
                            android:button="@null"
                            android:drawableEnd="@drawable/sel_radio_check_indicator"
                            android:lineSpacingExtra="2dp"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:text="Nonaktif\nTrafik internet tetap berjalan normal jika VPN terputus"
                            android:textColor="@color/sel_radio_text_color"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbKsUnexpected"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/sel_radio_option_card"
                            android:button="@null"
                            android:drawableEnd="@drawable/sel_radio_check_indicator"
                            android:lineSpacingExtra="2dp"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:text="Blokir saat terputus mendadak\nHentikan sementara akses internet saat koneksi VPN hilang"
                            android:textColor="@color/sel_radio_text_color"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbKsLockdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/sel_radio_option_card"
                            android:button="@null"
                            android:drawableEnd="@drawable/sel_radio_check_indicator"
                            android:lineSpacingExtra="2dp"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:text="Lockdown ketat\nBlokir seluruh akses jaringan saat tidak terhubung ke VPN"
                            android:textColor="@color/sel_radio_text_color"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.axel.mba.bpvpn.ui.view.LiquidGlassCardView>

            <!-- Auto-Reconnect Card -->
            <com.axel.mba.bpvpn.ui.view.LiquidGlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hubungkan Ulang Otomatis"
                                android:textColor="#F4F4F7"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Otomatis menyambung jika sinyal WiFi / Seluler berganti"
                                android:textColor="#85889A"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAutoReconnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/sel_switch_thumb"
                            app:trackTint="@color/sel_switch_track"
                            app:useMaterialThemeColors="false" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="#1E2130" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STRATEGI HUBUNG ULANG (ALGORITMA)"
                        android:textColor="#686B80"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgReconnectStrategy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <RadioButton
                            android:id="@+id/rbImmediate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/sel_radio_option_card"
                            android:button="@null"
                            android:drawableEnd="@drawable/sel_radio_check_indicator"
                            android:lineSpacingExtra="2dp"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:text="Instan\nCoba sambung kembali secara langsung hingga 3 kali"
                            android:textColor="@color/sel_radio_text_color"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbBackoff"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/sel_radio_option_card"
                            android:button="@null"
                            android:drawableEnd="@drawable/sel_radio_check_indicator"
                            android:lineSpacingExtra="2dp"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:text="Adaptif (Backoff)\nJeda waktu bertahap untuk kestabilan koneksi dan efisiensi"
                            android:textColor="@color/sel_radio_text_color"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbPersistent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/sel_radio_option_card"
                            android:button="@null"
                            android:drawableEnd="@drawable/sel_radio_check_indicator"
                            android:lineSpacingExtra="2dp"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:text="Berkala (Persisten)\nCoba sambung kembali secara berkala hingga terhubung"
                            android:textColor="@color/sel_radio_text_color"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.axel.mba.bpvpn.ui.view.LiquidGlassCardView>

            <!-- Permanent Attribution -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/credits_brand"
                android:textColor="#4E5164"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
