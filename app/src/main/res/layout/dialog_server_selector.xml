<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Subtle Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="#2E3042" />

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilihan Server"
        android:textColor="@color/bp_white_platinum"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Pilih server rute terenkripsi yang ingin digunakan."
        android:textColor="@color/bp_gray_titanium"
        android:textSize="12sp" />

    <!-- Server List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvServerLocations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <!-- Close Button (Clean dark background, no blinding white button) -->
    <TextView
        android:id="@+id/btnDismissDialog"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="TUTUP"
        android:textColor="@color/bp_white_platinum"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
