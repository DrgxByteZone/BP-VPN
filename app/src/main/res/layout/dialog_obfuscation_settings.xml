<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="OBFUSKASI JARINGAN"
        android:textColor="#10B981"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Pengaburan Paket WireGuard"
        android:textColor="#F4F4F7"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="16dp"
        android:text="Pengacakan ukuran dan pola paket handshake untuk meminimalkan deteksi firewall ISP."
        android:textColor="#85889A"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/rgObfuscation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbObfDisabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/sel_radio_option_card"
            android:button="@null"
            android:drawableEnd="@drawable/sel_radio_check_indicator"
            android:lineSpacingExtra="2dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Nonaktif (Standar)\nFormat paket asli WireGuard tanpa modifikasi"
            android:textColor="@color/sel_radio_text_color"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbObfLowPadding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/sel_radio_option_card"
            android:button="@null"
            android:drawableEnd="@drawable/sel_radio_check_indicator"
            android:lineSpacingExtra="2dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Padding Dinamis (16 - 64 B)\nMenyamarkan panjang paket handshake awal"
            android:textColor="@color/sel_radio_text_color"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbObfHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/sel_radio_option_card"
            android:button="@null"
            android:drawableEnd="@drawable/sel_radio_check_indicator"
            android:lineSpacingExtra="2dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Header Modifikasi\nMengubah struktur awal paket handshake"
            android:textColor="@color/sel_radio_text_color"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbObfStealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sel_radio_option_card"
            android:button="@null"
            android:drawableEnd="@drawable/sel_radio_check_indicator"
            android:lineSpacingExtra="2dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Mode Stealth\nKombinasi padding acak dan modifikasi header paket"
            android:textColor="@color/sel_radio_text_color"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/btnSaveObfuscation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pill_emerald"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:text="Simpan Pengaturan"
        android:textColor="#090A10"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
